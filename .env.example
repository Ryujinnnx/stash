# Stash dApp environment

# Target network. The frontend defaults to shelbynet when this is omitted.
VITE_APTOS_NETWORK=shelbynet

# Shelbinet public endpoints from Shelby docs.
VITE_APTOS_FULLNODE_URL=https://api.shelbynet.shelby.xyz/v1
VITE_APTOS_INDEXER_URL=https://api.shelbynet.shelby.xyz/v1/graphql
VITE_SHELBY_RPC_URL=https://api.shelbynet.shelby.xyz/shelby
VITE_SHELBY_WRITE_LOCATION=shelbynet-1

# Required after publishing the Move package to Shelbinet.
# Example shape: 0x1234...
VITE_STASH_MODULE_ADDRESS=0x2d82e8802ab2a3fcce32df2f663a05efcbba9ae00d755b76d242dffb087a4a83

# Optional but recommended for stable RPC/indexer behavior.
VITE_APTOS_API_KEY=
VITE_SHELBY_API_KEY=
